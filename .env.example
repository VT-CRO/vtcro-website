# ── Sanity (CMS) ──────────────────────────────────────────────
# From sanity.io/manage → your project. Until these are set, the site
# runs on the built-in sample content in /seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret used by the Sanity webhook that refreshes the live site
# after the website manager clicks "Publish". Any long random string.
SANITY_REVALIDATE_SECRET=

# ── Contact form email (resend.com) ──────────────────────────
# Without a key, the contact form shows the email address instead.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. website@vtcro.org
CONTACT_FROM_EMAIL=

# ── Site URL (used for SEO, sitemap, social previews) ─────────
NEXT_PUBLIC_SITE_URL=https://www.vtcro.org
